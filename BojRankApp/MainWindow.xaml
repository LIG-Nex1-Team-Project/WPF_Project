<Window x:Class="BojRankApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BojRankApp.ViewModel"
        xmlns:local="clr-namespace:BojRankApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.DataContext>
        <vm:UserViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>


        <Border Grid.Column="0"
                Padding="16"
                BorderBrush="LightGray"
                BorderThickness="0,0,1,0">

            <StackPanel>

                <TextBlock Text="사용자 검색"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <TextBox Width="200"
                         Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,0">
                    <Button 
                        Content="추가"
                        Command="{Binding AddUserCommand}"
                        CommandParameter="{Binding UserId}"
                        Width="80"
                        />
                    <Button Content="전체 갱신" 
                        Command="{Binding ResetUserCommand}"
                        Height="20" Width="79"/>

                    <Button 
                        Content="삭제"
                        Command="{Binding DelUserCommand}"
                        CommandParameter="{Binding UserId}"
                        Width="80"
                        Margin="0,10,0,20"
                        />
                </StackPanel>



                <TextBlock Text="사용자 목록"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <ListBox ItemsSource="{Binding Users}"
                         SelectedItem="{Binding SelectedUser}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8"
                                    Margin="0,0,0,5"
                                    BorderBrush="#DDD"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Id}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Rating}"
                                               FontSize="12"
                                               Foreground="Gray"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="태그 별 통계 (Top Types)" 
           FontWeight="Bold" 
           Margin="0,15,0,5"/>

                <ListView ItemsSource="{Binding SelectedSUser.StatisticsTags}" 
          Height="120" 
          BorderBrush="#DDD" 
          BorderThickness="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="태그" Width="100" DisplayMemberBinding="{Binding TagName}"/>
                            <GridViewColumn Header="해결" Width="50" DisplayMemberBinding="{Binding TagCount}"/>
                            <GridViewColumn Header="비율" Width="60" DisplayMemberBinding="{Binding TagPercent, StringFormat={}{0:F1}%}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock Text="티어 별 통계 (Tier Distribution)" 
           FontWeight="Bold" 
           Margin="0,15,0,5"/>

                <ListView ItemsSource="{Binding SelectedSUser.StatisticsTiers}" 
          Height="120" 
          BorderBrush="#DDD" 
          BorderThickness="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="티어" Width="100" DisplayMemberBinding="{Binding TierName}"/>
                            <GridViewColumn Header="해결" Width="50" DisplayMemberBinding="{Binding TierCount}"/>
                            <GridViewColumn Header="비율" Width="60" DisplayMemberBinding="{Binding TierPercent, StringFormat={}{0:F1}%}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

            </StackPanel>

        </Border>

        <Border Grid.Column="1"
        Padding="16"
        BorderBrush="LightGray"
        BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 제목 -->
                <TextBlock Grid.Row="0"
                   Text="해결한 문제들"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

                <!-- 문제 목록 -->
                <ListBox Grid.Row="1"
                 ItemsSource="{Binding Problems}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8"
                            Margin="0,0,0,6"
                            BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Pid}"
                                       FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Difficulty}"
                                       FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Name}"
                                       FontSize="12"
                                       Foreground="Gray"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Grid>

        </Border>


    </Grid>
</Window>
