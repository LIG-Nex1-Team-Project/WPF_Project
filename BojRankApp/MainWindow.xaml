<Window x:Class="BojRankApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BojRankApp.ViewModel"
        xmlns:local="clr-namespace:BojRankApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="800">

    <Window.DataContext>
        <vm:UserViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>


        <!-- 왼쪽 위 View-->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 왼쪽 위 View-->
            <Border Grid.Row="0"
                CornerRadius="12"
                Padding="20"
                BorderBrush="#008C75"
                BorderThickness="0.5, 5, 0.5, 0.5"
                Margin="50 20 0 0">

                <Grid Margin="-10,0,0,0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="7*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,-10,0,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Margin="8">

                            <Border Width="22"
                                    Height="22"
                                    CornerRadius="6"
                                    Background="#E6F7F4"
                                    VerticalAlignment="Center">

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xEDE4;"
                                       FontSize="13"
                                       FontWeight="ExtraBold"
                                       Foreground="#00A896"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="사용자 검색"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="5, 0, 0, 0"/>
                        </StackPanel>

                        <Grid Grid.Row="0"
                              Margin="0,54,0,0" Height="24"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left" Width="309">

                            <Grid.ColumnDefinitions>
                                <!--  검색 박스 : 남은 공간 전부 -->
                                <ColumnDefinition Width="*"/>

                                <!-- 🔹 버튼들 : 고정 -->
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Height="36"
                                    
                                    CornerRadius="5"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="0"
                                    Background="White"
                                    Padding="12,0"
                                    VerticalAlignment="Center">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- 입력창이 같이 늘어남 -->
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 🔍 아이콘 -->
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE721;"
                                               FontSize="14"
                                               Foreground="#9E9E9E"
                                               VerticalAlignment="Center"/>

                                    <!-- 입력창 -->
                                    <TextBox Grid.Column="1"
                                             Margin="8,0,0,0"
                                             BorderThickness="1"
                                             Background="#F9FBFB"
                                             VerticalContentAlignment="Center"
                                             FontSize="13"
                                             Foreground="#424242"
                                             Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"
                                             CaretBrush="#00A896"
                                             >

                                    </TextBox>


                                </Grid>


                            </Border>

                            <!-- 검색 버튼 -->
                            <Button Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    Margin="6,0,0,0"
                                    Background="White"
                                    BorderBrush="#b5b5b5"
                                    Cursor="Hand"
                                    Command="{Binding AddUserCommand}"
                                    CommandParameter="{Binding UserId}">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="5"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE71E;"
                                           FontSize="14"
                                           Foreground="#4c4d4c"
                                           FontWeight="Regular"/>
                            </Button>

                            <!-- 새로 고침 버튼 -->
                            <Button Grid.Column="2"
                                    Width="24"
                                    Height="24"
                                    Margin="6,0,0,0"
                                    Background="White"
                                    BorderBrush="#B3DDD6"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Command="{Binding ResetUserCommand}">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="5"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xF143;"
                                           FontSize="20"
                                           Foreground="#00A896"
                                           FontWeight="ExtraLight"/>
                            </Button>

                            <!-- 삭제 버튼 -->
                            <Button Grid.Column="3"
                                    Width="24"
                                    Height="24"
                                    Margin="6 0,0,0"
                                    Background="White"
                                    BorderBrush="#FFCDD2"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    
                                    Command="{Binding DelUserCommand}"
                                    CommandParameter="{Binding UserId}">


                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="5"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE74D;"
                                           FontSize="14"
                                           Foreground="#E53935"/>
                            </Button>

                        </Grid>

                    </Grid>

                    <Grid Grid.Row="1" Margin="10 20 0 0">
                        <DataGrid AutoGenerateColumns="False"
                                  ColumnWidth="*"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="White"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  ItemsSource="{Binding Users}"
                                  SelectedItem="{Binding SelectedUser}" Margin="0 0 0 1"
                                  GridLinesVisibility="None">


                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0 0 0 5"/>
                                    <Setter Property="BorderBrush" Value="#919191"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Thin"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderThickness" Value="0, 0, 0, 1"/>
                                    <Setter Property="Margin" Value="0 2 0 2"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#EEEEEE"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#00d463"/>
                                        </Trigger>
                                    </Style.Triggers>

                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="30">
                                    
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="티어" Margin="5,0,0,0"/>
                                    </DataGridTemplateColumn.Header>
                                    
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding TierImageUrl}"
                                                    Height="18"
                                                    Stretch="Uniform"
                                                   />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Width="2.3*" Binding="{Binding Id}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="유저 ID" Margin="5,0,0,0"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn Header="해결 문제 수" Width="2.5*" 
                                                    Binding="{Binding SolvedCount}" />
                                <DataGridTextColumn Header="점수" Width="1.5*" 
                                                    Binding="{Binding Rating}" />

                            </DataGrid.Columns>

                        </DataGrid>


                    </Grid>

                </Grid>
            </Border>

            <!-- 왼쪽 아래 View-->
            <Border Grid.Row="1"
                CornerRadius="12"
                Padding="20"
                BorderBrush="#008C75"
                BorderThickness="0.5, 5, 0.5, 0.5"
                Margin="50 20 0 30">

                <StackPanel>
                    <TextBlock Text="태그 별 통계 (Top Types)" 
                               FontWeight="Bold" 
                               Margin="0,15,0,5"/>
                    <ListView ItemsSource="{Binding SelectedSUser.StatisticsTags}"
                              Height="120"
                              BorderBrush="#DDD" 
                              BorderThickness="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="태그" Width="100" DisplayMemberBinding="{Binding TagName}"/>
                                <GridViewColumn Header="해결" Width="50" DisplayMemberBinding="{Binding TagCount}"/>
                                <GridViewColumn Header="비율" Width="60" DisplayMemberBinding="{Binding TagPercent, StringFormat={}{0:F1}%}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock Text="티어 별 통계 (Tier Distribution)" 
                               FontWeight="Bold" 
                               Margin="0,15,0,5"/>

                    <ListView ItemsSource="{Binding SelectedSUser.StatisticsTiers}" 
                              Height="120" 
                              BorderBrush="#DDD" 
                              BorderThickness="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="티어" Width="100" DisplayMemberBinding="{Binding TierName}"/>
                                <GridViewColumn Header="해결" Width="50" DisplayMemberBinding="{Binding TierCount}"/>
                                <GridViewColumn Header="비율" Width="60" DisplayMemberBinding="{Binding TierPercent, StringFormat={}{0:F1}%}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>

            </Border>

        </Grid>


        <!-- 오른쪽 View-->
        <Border Grid.Column="1"
                Padding="16"
                BorderBrush="LightGray"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 제목 -->
                <TextBlock Grid.Row="0"
                           Text="해결한 문제들"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <!-- 문제 목록 -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Problems}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8"
                                    Margin="0,0,0,6"
                                    BorderBrush="#DDD"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Pid}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Difficulty}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               Foreground="Gray"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>


    </Grid>
</Window>
