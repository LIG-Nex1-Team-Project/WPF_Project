<Window x:Class="BojRankApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BojRankApp.ViewModel"
        xmlns:local="clr-namespace:BojRankApp"
        mc:Ignorable="d"
        Title="BoJRankApp" Height="850" Width="800">

    <Window.DataContext>
        <vm:UserViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="23*" />
            <ColumnDefinition Width="30*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="337*"/>
            <ColumnDefinition Width="400*" />
        </Grid.ColumnDefinitions>


        <!-- 왼쪽 위 View-->
        <Grid Grid.Column="0" Grid.ColumnSpan="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 왼쪽 위 View-->
            <Border Grid.Row="0"
                CornerRadius="12"
                Padding="20"
                BorderBrush="#008C75"
                BorderThickness="0.5, 5, 0.5, 0.5"
                Margin="50 20 0 0">

                <Grid Margin="-10,0,0,0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="7*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,-10,0,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Margin="8">

                            <Border Width="22"
                                    Height="22"
                                    CornerRadius="6"
                                    Background="#E6F7F4"
                                    VerticalAlignment="Center">

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xEDE4;"
                                       FontSize="13"
                                       FontWeight="ExtraBold"
                                       Foreground="#00A896"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="사용자 검색"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="5, 0, 0, 0"/>
                        </StackPanel>

                        <Grid Grid.Row="0"
                              Margin="0,54,0,0" Height="24"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left" Width="309">

                            <Grid.ColumnDefinitions>
                                <!--  검색 박스 : 남은 공간 전부 -->
                                <ColumnDefinition Width="*"/>

                                <!-- 🔹 버튼들 : 고정 -->
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Height="36"
                                    
                                    CornerRadius="5"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="0"
                                    Background="White"
                                    Padding="12,0"
                                    VerticalAlignment="Center">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- 입력창이 같이 늘어남 -->
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 🔍 아이콘 -->
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE721;"
                                               FontSize="14"
                                               Foreground="#9E9E9E"
                                               VerticalAlignment="Center"/>

                                    <!-- 입력창 -->
                                    <TextBox Grid.Column="1"
                                             Margin="8,0,0,0"
                                             BorderThickness="1"
                                             Background="#F9FBFB"
                                             VerticalContentAlignment="Center"
                                             FontSize="13"
                                             Foreground="#424242"
                                             Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"
                                             CaretBrush="#00A896"
                                             >

                                    </TextBox>


                                </Grid>


                            </Border>

                            <!-- 검색 버튼 -->
                            <Button Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    Margin="6,0,0,0"
                                    Background="White"
                                    BorderBrush="#b5b5b5"
                                    Cursor="Hand"
                                    Command="{Binding AddUserCommand}"
                                    CommandParameter="{Binding UserId}"
                                    IsDefault="True">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="5"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE71E;"
                                           FontSize="14"
                                           Foreground="#4c4d4c"
                                           FontWeight="Regular"/>
                            </Button>

                            <!-- 새로 고침 버튼 -->
                            <Button Grid.Column="2"
                                    Width="24"
                                    Height="24"
                                    Margin="6,0,0,0"
                                    Background="White"
                                    BorderBrush="#B3DDD6"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Command="{Binding ResetUserCommand}">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="5"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xF143;"
                                           FontSize="20"
                                           Foreground="#00A896"
                                           FontWeight="ExtraLight"/>
                            </Button>

                            <!-- 삭제 버튼 -->
                            <Button Grid.Column="3"
                                    Width="24"
                                    Height="24"
                                    Margin="6 0,0,0"
                                    Background="White"
                                    BorderBrush="#FFCDD2"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    
                                    Command="{Binding DelUserCommand}"
                                    CommandParameter="{Binding UserId}">


                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="5"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE74D;"
                                           FontSize="14"
                                           Foreground="#E53935"/>
                            </Button>

                        </Grid>

                    </Grid>

                    <Grid Grid.Row="1" Margin="10 20 0 0">
                        <DataGrid AutoGenerateColumns="False"
                                  ColumnWidth="*"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="White"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  ItemsSource="{Binding Users}"
                                  SelectedItem="{Binding SelectedUser}" Margin="0 0 0 1"
                                  GridLinesVisibility="None">


                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0 0 0 5"/>
                                    <Setter Property="BorderBrush" Value="#919191"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Thin"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderThickness" Value="0, 0, 0, 1"/>
                                    <Setter Property="Margin" Value="0 2 0 2"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#EEEEEE"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#00d463"/>
                                        </Trigger>
                                    </Style.Triggers>

                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="30">
                                    
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="티어" Margin="5,0,0,0"/>
                                    </DataGridTemplateColumn.Header>
                                    
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding TierImageUrl}"
                                                    Height="18"
                                                    Stretch="Uniform"
                                                   />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Width="2.3*" Binding="{Binding Id}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="유저 ID" Margin="5,0,0,0"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn Header="해결 문제 수" Width="2.5*" 
                                                    Binding="{Binding SolvedCount}"/>
                                <DataGridTextColumn Header="점수" Width="1.5*" 
                                                    Binding="{Binding Rating}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>

            <!-- 왼쪽 아래 View-->
            <Border Grid.Row="1"
                    CornerRadius="12"
                    Padding="20"
                    BorderBrush="#008C75"
                    BorderThickness="0.5, 5, 0.5, 0.5"
                    Margin="50 20 0 30">

                <Grid Margin="0,-5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="▪️ 유형 별 통계" 
                               FontWeight="Bold" 
                               Margin="0,0,0,5"/>

                    <DataGrid Grid.Row="1"
                              AutoGenerateColumns="False"
                              ColumnWidth="*"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="White"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              ItemsSource="{Binding SelectedSUser.StatisticsTags}"
                              SelectedItem="{Binding SelectedSUser}"
                              GridLinesVisibility="None"
                              VerticalScrollBarVisibility="Auto"
                              IsReadOnly="True">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0,0,0,5"/>
                                <Setter Property="BorderBrush" Value="#919191"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Margin" Value="0,2,0,2"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="#EEEEEE"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E6F7F4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="유형" Width="2.5*" Binding="{Binding TagName}"/>
                            <DataGridTextColumn Header="해결" Width="2*" Binding="{Binding TagCount}"/>
                            <DataGridTextColumn Header="비율" Width="2*" Binding="{Binding TagPercent, StringFormat={}{0:F1}%}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" 
                               Text="▪️ 티어 별 통계" 
                               FontWeight="Bold" 
                               Margin="0,15,0,5"/>

                    <DataGrid Grid.Row="3"
                              AutoGenerateColumns="False"
                              ColumnWidth="*"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="White"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              ItemsSource="{Binding SelectedSUser.StatisticsTiers}"
                              SelectedItem="{Binding SelectedSUser}" 
                              GridLinesVisibility="None"
                              VerticalScrollBarVisibility="Auto"
                              IsReadOnly="True">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0,0,0,5"/>
                                <Setter Property="BorderBrush" Value="#919191"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Margin" Value="0,2,0,2"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="#EEEEEE"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E6F7F4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="티어" Width="2.5*" Binding="{Binding TierName}"/>
                            <DataGridTextColumn Header="해결" Width="2*" Binding="{Binding TierCount}"/>
                            <DataGridTextColumn Header="비율" Width="2*" Binding="{Binding TierPercent, StringFormat={}{0:F1}%}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>


        <!-- 오른쪽 View-->
        <Border Grid.Column="4"
                CornerRadius="12"
                
                BorderBrush="#0089D0"
                BorderThickness="0.5, 5, 0.5, 0.5"
                Margin="20 20 45 30">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="15,15,15,5">

                    <Border Width="22"
                            Height="22"
                            CornerRadius="6"
                            Background="#ebebeb"
                            VerticalAlignment="Center">
                        
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xEDE3;"
                                   FontSize="15"
                                   FontWeight="Light"
                                   Foreground="#000000"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    
                    <TextBlock Text="메뉴 선택"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="5, 0, 0, 0"/>
                </StackPanel>
                
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="15,6,15,5">
                    
                    <RadioButton Content="해결한 문제"
                                 GroupName="ProblemFilter"
                                 IsChecked="{Binding }}"
                                 Margin="0,0,15,0"
                                 FontSize="13"
                                 FontWeight="SemiBold"/>
                    
                    <RadioButton Content="시도 중인 문제"
                                 GroupName="ProblemFilter"
                                 FontSize="13"
                                 FontWeight="SemiBold"/>
                </StackPanel>
                
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"                            
                            VerticalAlignment="Top"
                            Margin="15">

                    <Border Width="22"
                            Height="22"
                            CornerRadius="6"
                            Background="#E6F4FB"
                            VerticalAlignment="Center">

                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE73A;"
                                   FontSize="13"
                                   FontWeight="ExtraBold"
                                   Foreground="#46AADD"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="문제 리스트"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="5, 0, 0, 0"/>
                </StackPanel>

                <!-- 문제 목록 -->
                <ListBox Grid.Row="3"
                         ItemsSource="{Binding Problems}"
                         MouseDoubleClick="ListBox_MouseDoubleClick"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         Margin="15 0 15 10">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8"
                                    Margin="0,0,0,6"
                                    BorderBrush="#DDD"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Pid}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Difficulty}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               Foreground="Gray"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>


    </Grid>
</Window>
