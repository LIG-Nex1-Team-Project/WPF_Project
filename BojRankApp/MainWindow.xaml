<Window x:Class="BojRankApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BojRankApp.ViewModel"
        xmlns:local="clr-namespace:BojRankApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.DataContext>
        <vm:UserViewModel/>
    </Window.DataContext>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>


        <Border Grid.Column="0"
                Padding="16"
                BorderBrush="LightGray"
                BorderThickness="0,0,1,0">

            <StackPanel>

                <TextBlock Text="사용자 추가"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <TextBox Width="200"
                         Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Content="추가"
                        Command="{Binding AddUserCommand}"
                        Width="80"
                        Margin="0,10,0,20"/>


                <TextBlock Text="사용자 목록"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <ListBox ItemsSource="{Binding Users}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8"
                                    Margin="0,0,0,5"
                                    BorderBrush="#DDD"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Id}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Rating}"
                                               FontSize="12"
                                               Foreground="Gray"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </StackPanel>

        </Border>
    </Grid>
</Window>
